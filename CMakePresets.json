{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
    "configurePresets": [
        {
            "name": "windows",
            "displayName": "Windows (Ninja Multi-Config, MSVC)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-asan",
            "inherits": "windows",
            "displayName": "Windows + AddressSanitizer",
            "binaryDir": "${sourceDir}/build-asan",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug",
                "CMAKE_CXX_FLAGS_INIT": "/fsanitize=address"
            }
        }
    ],
    "buildPresets": [
        { "name": "release", "configurePreset": "windows", "configuration": "Release" },
        { "name": "debug",   "configurePreset": "windows", "configuration": "Debug"   },
        { "name": "asan",    "configurePreset": "windows-asan", "configuration": "Debug" }
    ],
    "testPresets": [
        { "name": "release", "configurePreset": "windows",      "configuration": "Release", "output": { "outputOnFailure": true } },
        { "name": "debug",   "configurePreset": "windows",      "configuration": "Debug",   "output": { "outputOnFailure": true } },
        { "name": "asan",    "configurePreset": "windows-asan", "configuration": "Debug",   "output": { "outputOnFailure": true } }
    ],
    "packagePresets": [
        {
            "name": "release",
            "configurePreset": "windows",
            "configurations": ["Release"],
            "generators": ["ZIP"],
            "packageDirectory": "${sourceDir}/build/package"
        }
    ]
}
